<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 排除含 token/密码（AES-GCM 加密）的凭据文件，防止云备份泄露 -->
        <exclude domain="file" path="datastore/user_credential.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- 设备迁移同样排除凭据文件 -->
        <exclude domain="file" path="datastore/user_credential.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
